---
// Tåler både et Sanity-bilde og en vanlig bildeadresse.
import { bildeUrl } from "../lib/bilde";

interface Props {
  kilde: any;
  alt?: string;
  bredde?: number;
  variant?: "standard" | "bred" | "fri";
  loading?: "lazy" | "eager";
  klasse?: string;
}

const {
  kilde,
  alt = "",
  bredde = 900,
  variant = "standard",
  loading = "lazy",
  klasse = "",
} = Astro.props;

const src = bildeUrl(kilde, bredde);
const altTekst =
  typeof kilde === "string" ? alt : alt || kilde?.alt || "";

const flateklasse = [
  "bildeflate",
  variant === "bred" ? "bildeflate--bred" : "",
  variant === "fri" ? "bildeflate--fri" : "",
  klasse,
]
  .filter(Boolean)
  .join(" ");
---

{
  src ? (
    <div class={flateklasse}>
      <img src={src} alt={altTekst} loading={loading} decoding="async" />
    </div>
  ) : (
    <div class={flateklasse} aria-hidden="true" />
  )
}
