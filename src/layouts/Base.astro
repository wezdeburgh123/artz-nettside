---
import "../styles/global.css";
import Former from "../components/Former.astro";
import { datasettStatus } from "../lib/sanity";

interface Props {
  tittel: string;
  beskrivelse?: string;
  // Absolutt bildeadresse til deling på Facebook og lignende. Verksider
  // sender med verket, slik at en delt lenke viser kunsten og ikke bare tekst.
  delebilde?: string;
}

const { tittel, beskrivelse = "ARTZ formidler samtidskunst til bedrifter, kunstforeninger og private. Salgsutstillinger, utsmykking og eget rammeverksted.", delebilde } =
  Astro.props;

const meny = [
  { navn: "Kunstnere", url: "/kunstnere" },
  { navn: "Verk", url: "/galleri" },
  { navn: "Utsmykking", url: "/utsmykking" },
  { navn: "Rammeverkstedet", url: "/rammeverkstedet" },
  { navn: "Grafikksenteret", url: "/grafikksenteret" },
  { navn: "Registerdrift", url: "/registerdrift" },
  { navn: "Om kunsten", url: "/om-kunsten" },
  { navn: "Kontakt", url: "/kontakt" },
];

const sti = Astro.url.pathname;

const status = await datasettStatus();
const varsel: Record<string, string | null> = {
  "ikke-koblet":
    "Sanity er ikke koblet på ennå. Kunstnere og verk er derfor tomme, og de faste sidene viser standardtekst.",
  tomt: "Sanity er koblet på, men inneholder ingenting ennå. Kunstnere og verk er tomme, og de faste sidene viser standardtekst.",
  utilgjengelig:
    "Sanity svarer ikke akkurat nå, så kunstnere og verk vises ikke. Prøv å laste siden på nytt.",
  "har-innhold": null,
};
const varselTekst = varsel[status];
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tittel} · ARTZ</title>
    <meta name="description" content={beskrivelse} />
    <meta property="og:title" content={`${tittel} · ARTZ`} />
    <meta property="og:description" content={beskrivelse} />
    <meta property="og:locale" content="nb_NO" />
    <meta property="og:type" content="website" />
    {delebilde && <meta property="og:image" content={delebilde} />}
    <meta name="twitter:card" content={delebilde ? "summary_large_image" : "summary"} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    {varselTekst && <p class="varsel">{varselTekst}</p>}

    <header class="topp korn">
      <div class="innhold topp__rad">
        <a class="logo" href="/">ARTZ</a>
        <nav aria-label="Hovedmeny">
          <ul class="meny">
            {
              meny.map((punkt) => (
                <li>
                  <a
                    href={punkt.url}
                    aria-current={sti.startsWith(punkt.url) ? "page" : undefined}
                  >
                    {punkt.navn}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="hovedinnhold">
      <slot />
    </main>

    <footer class="bunn korn formlag formlag--klipp">
      <Former variant="bue" klasse="form--bunn" />
      <div class="innhold bunn__rad overform">
        <div>
          <p class="stikkord">ARTZ</p>
          <p class="meta">
            Kunstformidling, utsmykking og rammeverksted.<br />
            <a href="mailto:post@artz.no">post@artz.no</a>
          </p>
        </div>
        <p class="meta">
          © {new Date().getFullYear()} ARTZ. Alle verk tilhører kunstnerne.
        </p>
      </div>
    </footer>

    <style>
      /* Toppen ligger som et tynt slør over innholdet som ruller under.
         Papirfargen med litt gjennomsikt, ikke glass. Effekten skal knapt
         merkes, den er der for å vise at siden fortsetter bak menyen.
         rgba-linja er reserve for nettlesere uten color-mix. Uten den
         ville menyen blitt helt gjennomsiktig der. */
      .topp {
        border-bottom: 1px solid var(--strek);
        position: sticky;
        top: 0;
        z-index: 10;
        background: rgba(255, 254, 252, 0.88);
        background: color-mix(in srgb, var(--papir-hevet) 88%, transparent);
        backdrop-filter: blur(14px) saturate(1.35);
        --korn-styrke: 0.2;
      }

      /* Ingen -webkit-backdrop-filter her. Astros minifier ser de to
         erklæringene som samme egenskap og beholder bare den siste, så det
         prefiksede paret overlever ikke bygget uansett. Verifisert i
         dist-CSS-en 14. august 2026. Safari før 18 får derfor regelen
         under: heldekkende papir, ingen gjennomsikt. */

      /* Uten backdrop-filter blir gjennomsikten bare uskarp tekst under
         menyen. Da er heldekkende papir riktig. */
      @supports not (backdrop-filter: blur(1px)) {
        .topp {
          background: var(--papir-hevet);
        }
      }

      /* Noen slår av gjennomsikt i systeminnstillingene, ofte fordi tekst
         over urolig bakgrunn er vanskelig å lese. Da respekterer vi det. */
      @media (prefers-reduced-transparency: reduce) {
        .topp {
          background: var(--papir-hevet);
          backdrop-filter: none;
        }
      }

      .topp__rad {
        position: relative;
        z-index: 1;
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.75rem 2rem;
        padding-block: 1.1rem;
      }

      .logo {
        font-family: var(--sans);
        font-size: 1.125rem;
        letter-spacing: 0.28em;
        font-weight: 500;
        border: 0;
        margin-right: auto;
      }

      .meny {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 1.4rem;
        margin: 0;
        padding: 0;
        font-family: var(--sans);
        font-size: 0.9375rem;
      }

      .meny a {
        border-bottom-color: transparent;
        padding-block: 0.35rem;
        display: inline-block;
      }

      .meny a:hover,
      .meny a[aria-current="page"] {
        border-bottom-color: var(--tusj);
      }

      /* Bunnen starter på hevet papir og lander på papir når kornet er
         lagt på. Se --papir-hevet i global.css. Uten den blir bunnen et
         grått bånd mot resten av siden. */
      .bunn {
        border-top: 1px solid var(--strek);
        margin-top: clamp(2rem, 5vw, 3.5rem);
        padding-block: 2.25rem;
        background: var(--papir-hevet);
        --korn-styrke: 0.24;
      }

      .bunn__rad {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 1.5rem;
        align-items: end;
      }

      .bunn p {
        margin: 0 0 0.35em;
      }
    </style>
  </body>
</html>
