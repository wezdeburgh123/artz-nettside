---
import Base from "../../layouts/Base.astro";
import Bilde from "../../components/Bilde.astro";
import { alleKunstnere } from "../../lib/sanity";

const kunstnere = await alleKunstnere();

// Vises bare når minst ett kort låner en generativ plassholder. Forsvinner
// av seg selv når ekte verk er lagt inn på alle kunstnerne.
const viserPlassholdere = kunstnere.some(
  (k: any) => k.kortbildekilde === "plassholder"
);

function altTekst(k: any): string {
  if (k.kortbildekilde === "portrett") return k.portrett?.alt || k.navn;
  if (k.kortbildekilde === "verk") return `Verk av ${k.navn}`;
  if (k.kortbildekilde === "plassholder")
    return `Generativ plassholder for ${k.navn}. Ikke et verk av kunstneren.`;
  return "";
}
---

<Base
  tittel="Kunstnere"
  beskrivelse="Kunstnerne ARTZ samarbeider med."
>
  <section class="seksjon innhold">
    <h1>Kunstnere</h1>
    <p class="ingress">
      Vi samarbeider med et utvalg kunstnere og deres grafiske verksted.
    </p>

    {
      viserPlassholdere && (
        <p class="forbehold">
          Kortene som er merket <span class="forbehold__ord">Plassholder</span>
          viser en generativ illustrasjon laget for ARTZ. Den er ikke et verk av
          kunstneren.
        </p>
      )
    }

    {
      kunstnere.length > 0 ? (
        <ul class="rutenett kunstnerliste">
          {kunstnere.map((k: any) => (
            <li>
              <a class="kunstner" href={`/kunstnere/${k.slug}`}>
                <div class="kunstner__flate">
                  <Bilde kilde={k.kortbilde} alt={altTekst(k)} bredde={600} />
                  {k.kortbildekilde === "plassholder" && (
                    <span class="merkelapp merkelapp--plassholder kunstner__merke">
                      Plassholder
                    </span>
                  )}
                </div>
                <h2>{k.navn}</h2>
                {k.levetid && <p class="meta">{k.levetid}</p>}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="tomt">
          Kunstnerne legges ut fortløpende. Ta kontakt på{" "}
          <a href="mailto:post@artz.no">post@artz.no</a>{" "}for informasjon om hva
          vi har tilgjengelig.
        </p>
      )
    }
  </section>
</Base>

<style>
  .kunstnerliste {
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  .forbehold {
    margin-top: 1.25rem;
    max-width: 46ch;
    font-size: 0.9375rem;
    color: var(--tusj-dempet);
  }

  .kunstner {
    border: 0;
    display: block;
  }

  /* Merket ligger over bildeflaten, ikke under navnet. Forbeholdet gjelder
     bildet, og leses derfor sammen med bildet. Papirbakgrunn gjør at det
     står like tydelig over et lyst som over et mørkt motiv. */
  .kunstner__flate {
    position: relative;
  }

  .kunstner__merke {
    position: absolute;
    left: 0.55rem;
    bottom: 0.55rem;
    background: var(--papir);
  }

  .forbehold__ord {
    font-family: var(--sans);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tusj);
  }

  .kunstner h2 {
    font-size: 1.125rem;
    margin: 0.9rem 0 0.1em;
  }

  .kunstner:hover h2 {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .kunstner .meta {
    margin: 0;
  }

  .tomt {
    margin-top: 2.5rem;
    font-size: 1.0625rem;
  }
</style>
