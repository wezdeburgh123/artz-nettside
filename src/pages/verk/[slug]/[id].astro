---
import imageUrlBuilder from "@sanity/image-url";
import { sanityClient } from "sanity:client";
import Base from "../../../layouts/Base.astro";
import Bilde from "../../../components/Bilde.astro";
import VerkKort from "../../../components/VerkKort.astro";
import Lyskasse from "../../../components/Lyskasse.astro";
import { verkMedId, verkSlug, verkUrl, TEKNIKK_NAVN } from "../../../lib/sanity";

const { slug, id } = Astro.params;

let dokumentId = id ?? "";
try {
  dokumentId = decodeURIComponent(dokumentId);
} catch {
  // Ugyldig prosentkoding. La strengen stå, oppslaget under finner ingenting.
}

const verk: any = dokumentId ? await verkMedId(dokumentId) : null;

// Finnes ikke verket, send til oversikten framfor å vise en tom side.
if (!verk) {
  return Astro.redirect("/galleri", 302);
}

// Én adresse per verk. Kommer noen inn med gammel eller feil titteldel,
// for eksempel fordi tittelen er endret i Sanity, flyttes de til den riktige.
const riktigSlug = verkSlug(verk.tittel);
if (slug !== riktigSlug) {
  return Astro.redirect(verkUrl(verk), 301);
}

// Et plassholderbilde skal ikke stå med et kunstnernavn noe sted på siden.
// Koblingen finnes i dataene fordi den styrer hvilket bilde kunstnerkortet
// låner, men den vises ikke. Se verk-skjemaet.
const erPlassholder = verk.plassholder === true;
const visKunstner = !erPlassholder && Boolean(verk.kunstner);

const detaljer = [
  ["Kunstner", visKunstner ? verk.kunstner.navn : null],
  ["Teknikk", verk.teknikk ? TEKNIKK_NAVN[verk.teknikk] ?? verk.teknikk : null],
  ["År", verk.aar],
  ["Mål", verk.maal],
  ["Opplag", verk.opplag],
].filter(([, verdi]) => Boolean(verdi)) as [string, string][];

const solgt = !erPlassholder && verk.status === "solgt";
// «Flere verk av» henter fra samme kunstner. For en plassholder ville det
// vært den andre plassholderen, under et navn vi nettopp har tatt bort.
const andreVerk: any[] = erPlassholder
  ? []
  : (verk.andreVerk ?? []).filter((v: any) => v?.plassholder !== true);

// Emnefelt ferdig utfylt. Da slipper den som skriver å forklare hvilket verk
// det gjelder, og ARTZ slipper å gjette.
const emne = encodeURIComponent(
  `Forespørsel: ${verk.tittel}${visKunstner ? ` av ${verk.kunstner.navn}` : ""}`
);

let delebilde: string | undefined;
if (verk.bilde?.asset?._ref) {
  delebilde = imageUrlBuilder(sanityClient)
    .image(verk.bilde)
    .width(1200)
    .height(630)
    .fit("fill")
    .bg("f1efe9")
    .auto("format")
    .url();
}

const beskrivelse = verk.beskrivelse
  ? String(verk.beskrivelse).slice(0, 200)
  : `${verk.tittel}${visKunstner ? ` av ${verk.kunstner.navn}` : ""}. Formidlet av ARTZ.`;
---

<Base tittel={verk.tittel} beskrivelse={beskrivelse} delebilde={delebilde}>
  <article class="seksjon innhold">
    <p class="stikkord smuler">
      <a href="/galleri">Verk</a>
      {
        visKunstner && (
          <>
            <span aria-hidden="true"> / </span>
            <a href={`/kunstnere/${verk.kunstner.slug}`}>{verk.kunstner.navn}</a>
          </>
        )
      }
    </p>

    <div class="verkflate">
      <Bilde
        kilde={verk.bilde}
        alt={
          erPlassholder
            ? "Generativ plassholder fra serien Registerdrift. Ikke et verk av en av kunstnerne."
            : verk.bilde?.alt || `${verk.tittel}${visKunstner ? ` av ${verk.kunstner.navn}` : ""}`
        }
        bredde={1800}
        variant="fri"
        loading="eager"
      />
    </div>

    <div class="under">
      <div class="tekst">
        <h1>{verk.tittel}</h1>
        {
          visKunstner && (
            <p class="kunstner">
              <a href={`/kunstnere/${verk.kunstner.slug}`}>{verk.kunstner.navn}</a>
            </p>
          )
        }

        {erPlassholder && (
          <p class="merkelapp merkelapp--plassholder">Plassholder</p>
        )}
        {solgt && <p class="merkelapp">Solgt</p>}

        {verk.beskrivelse && (
          <div class="prosa om">
            {String(verk.beskrivelse)
              .split(/\n{2,}/)
              .map((avsnitt: string) => <p>{avsnitt}</p>)}
          </div>
        )}
      </div>

      <aside class="fakta">
        <dl>
          {
            detaljer.map(([navn, verdi]) => (
              <div class="rad">
                <dt class="stikkord">{navn}</dt>
                <dd>{verdi}</dd>
              </div>
            ))
          }
        </dl>

        <p class="foresporsel">
          {
            erPlassholder
              ? "Dette bildet er ikke til salgs. Ta kontakt så forteller vi hva vi har tilgjengelig."
              : solgt
                ? "Dette verket er solgt. Vi har ofte flere arbeider av samme kunstner."
                : "Ta kontakt for pris og tilgjengelighet."
          }
        </p>
        <a class="knapp" href={`mailto:post@artz.no?subject=${emne}`}>
          {erPlassholder ? "Ta kontakt" : "Spør om dette verket"}
        </a>
      </aside>
    </div>

    {
      andreVerk.length > 0 && visKunstner && (
        <section class="mer">
          <p class="stikkord">Flere verk av {verk.kunstner.navn}</p>
          <ul class="rutenett">
            {andreVerk.map((v: any) => (
              <li>
                <VerkKort verk={v} visKunstner={false} />
              </li>
            ))}
          </ul>
          <p class="meta tilbake">
            <a href={`/galleri?kunstner=${verk.kunstner.slug}`}>
              Se alle verk av {verk.kunstner.navn}
            </a>
          </p>
        </section>
      )
    }
  </article>

  {/* Gjelder «flere verk»-rutenettet nederst. Selve verket vises
      allerede stort øverst og trenger ingen lyskasse. */}
  <Lyskasse />
</Base>

<style>
  .smuler a {
    border-bottom-color: transparent;
  }

  .smuler a:hover {
    border-bottom-color: var(--tusj-dempet);
  }

  /* Verket er varen. Bildet får hele bredden, men aldri mer høyde enn
     skjermen, slik at hele arbeidet er synlig uten å bla. */
  .verkflate {
    background: var(--papir-dyp);
    display: grid;
    place-items: center;
    padding: clamp(1rem, 4vw, 3rem);
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .verkflate :global(.bildeflate) {
    background: none;
    padding: 0;
    width: auto;
  }

  .verkflate :global(img) {
    max-height: 78vh;
    width: auto;
    max-width: 100%;
  }

  .under {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  @media (min-width: 56rem) {
    .under {
      grid-template-columns: minmax(0, 1fr) 18rem;
    }
  }

  h1 {
    margin-bottom: 0.15em;
  }

  .kunstner {
    font-size: 1.25rem;
    margin: 0 0 1rem;
  }

  .om {
    margin-top: 1.5rem;
  }

  .fakta dl {
    margin: 0 0 1.75rem;
    border-top: 1px solid var(--strek);
  }

  .fakta .rad {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--strek);
  }

  .fakta dt {
    margin: 0;
  }

  .fakta dd {
    margin: 0;
    font-family: var(--sans);
    font-size: 0.9375rem;
    text-align: right;
  }

  .foresporsel {
    font-family: var(--sans);
    font-size: 0.9375rem;
    margin-bottom: 1rem;
  }

  .mer {
    margin-top: clamp(3rem, 7vw, 5rem);
    border-top: 1px solid var(--strek);
    padding-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  .tilbake {
    margin-top: 1.75rem;
    margin-bottom: 0;
  }
</style>
