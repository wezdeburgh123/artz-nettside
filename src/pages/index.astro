---
import Base from "../layouts/Base.astro";
import Bilde from "../components/Bilde.astro";
import VerkKort from "../components/VerkKort.astro";
import Lyskasse from "../components/Lyskasse.astro";
import Tekst from "../components/Tekst.astro";
import Former from "../components/Former.astro";
import { sideMedNokkel, framhevedeVerk, alleKunstnere } from "../lib/sanity";
import { standardBein } from "../lib/standardtekst";

const side = await sideMedNokkel("forside");
const verk = await framhevedeVerk();
const kunstnere = await alleKunstnere();

// De tre boksene kommer fra Sanity når forsiden er lagt inn der, ellers fra
// standardteksten. André redigerer overskrift, tekst og hvilken side boksen
// peker til. Formen og lenketeksten utledes her, av to grunner: de er dekor
// og navigasjon, ikke innhold, og det er to felt mindre han kan gjøre feil.
//
// Formvalget: sirklene er kunsten som møter et publikum, strekene er
// trykkarket, de stablede rammene er passepartouten.
const FORM_FOR_LENKE: Record<string, "sirkler" | "strek" | "ramme" | "raster" | "passkors"> = {
  "/galleri": "sirkler",
  "/utsmykking": "strek",
  "/rammeverkstedet": "ramme",
  "/grafikksenteret": "raster",
  "/om-kunsten": "passkors",
  "/kontakt": "passkors",
};

const LENKETEKST: Record<string, string> = {
  "/galleri": "Se verk",
  "/utsmykking": "Om utsmykking",
  "/rammeverkstedet": "Om rammeverkstedet",
  "/grafikksenteret": "Om Grafikksenteret",
  "/om-kunsten": "Om kunsten",
  "/kontakt": "Ta kontakt",
};

const beinFraInnhold =
  side?.bein && side.bein.length > 0 ? side.bein : standardBein;

const bein = beinFraInnhold
  .filter((b: any) => b?.tittel && b?.lenke)
  .map((b: any) => ({
    tittel: b.tittel,
    tekst: b.tekst ?? "",
    url: b.lenke,
    lenke: LENKETEKST[b.lenke] ?? "Les mer",
    form: FORM_FOR_LENKE[b.lenke] ?? "passkors",
  }));
---

<Base tittel="Kunstformidling og rammeverksted">
  <section class="apning formlag formlag--klipp">
    <Former variant="bue" klasse="form--apning-bue" />

    <div class="innhold apning__rad overform">
      <div class="apning__tekst">
        <h1>{side?.tittel}</h1>
        <p class="ingress">{side?.ingress}</p>
        <p><a class="knapp" href="/galleri">Se verkene</a></p>
      </div>
      {side?.bilde && (
        <div class="apning__bilde">
          <Former variant="raster" klasse="form--bilde-raster" />
          <Bilde
            kilde={side.bilde}
            alt={side.bilde?.alt || ""}
            bredde={1100}
            variant="bred"
            loading="eager"
          />
        </div>
      )}
    </div>
  </section>

  <section class="seksjon innhold">
    <ul class="bein">
      {
        bein.map((b) => (
          <li>
            <Former variant={b.form} klasse="form--merke" />
            <h2>{b.tittel}</h2>
            <p>{b.tekst}</p>
            <p><a href={b.url}>{b.lenke}</a></p>
          </li>
        ))
      }
    </ul>
  </section>

  {
    verk.length > 0 && (
      <section class="seksjon seksjon--delt innhold formlag">
        <Former variant="passkors" klasse="form--seksjonsmerke" />
        <p class="stikkord">Utvalgte verk</p>
        <ul class="rutenett">
          {verk.map((v: any) => (
            <li><VerkKort verk={v} /></li>
          ))}
        </ul>
        <p class="mer"><a href="/galleri">Alle verk</a></p>
      </section>
    )
  }

  {
    side?.sitat && (
      <section class="seksjon seksjon--delt innhold">
        <blockquote class="sitat">
          <p>{side.sitat}</p>
        </blockquote>
      </section>
    )
  }

  {
    side?.tekst && (
      <section class="seksjon seksjon--delt innhold">
        <Tekst verdi={side.tekst} />
      </section>
    )
  }

  {
    kunstnere.length > 0 && (
      <section class="seksjon seksjon--delt innhold formlag">
        <Former variant="passkors" klasse="form--seksjonsmerke" />
        <p class="stikkord">Kunstnere</p>
        <p class="navneliste">
          {kunstnere.map((k: any, i: number) => (
            <>
              {i > 0 && <span aria-hidden="true"> · </span>}
              <a href={`/kunstnere/${k.slug}`}>{k.navn}</a>
            </>
          ))}
        </p>
      </section>
    )
  }

  <Lyskasse />
</Base>

<style>
  .apning {
    padding-top: clamp(2rem, 6vw, 4.5rem);
  }

  /* Rasteret ligger absolutt inne i denne, og bak bildet. */
  .apning__bilde {
    position: relative;
  }

  .apning__rad {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  @media (min-width: 56rem) {
    .apning__rad {
      grid-template-columns: 1fr 1.15fr;
    }
  }

  .bein {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    border-top: 1px solid var(--strek);
    padding-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  @media (min-width: 48rem) {
    .bein {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .bein h2 {
    font-size: 1.375rem;
  }

  .mer {
    margin-top: 2.5rem;
    font-family: var(--sans);
    font-size: 0.9375rem;
  }

  /* Uthevet setning. Samme serif som resten av siden, bare større og med
     god luft rundt. Ingen anførselstegn og ingen kursiv: dette er ARTZ som
     sier noe om seg selv, ikke et sitat fra en annen. */
  .sitat {
    margin: 0;
    text-align: center;
    padding-block: clamp(1rem, 3vw, 2.5rem);
  }

  /* Bredden står på avsnittet, ikke på blockquote. em regnes mot elementets
     egen skriftstørrelse, og blockquote arver grunnskriften. Sto den der,
     ble linja under halvparten så lang som tiltenkt. */
  .sitat p {
    font-size: clamp(1.375rem, 2.8vw, 1.9375rem);
    line-height: 1.35;
    margin: 0 auto;
    max-width: 15em;
    text-wrap: balance;
  }

  .navneliste {
    max-width: 46em;
    font-size: 1.125rem;
    line-height: 2;
  }
</style>
