---
import Base from "../layouts/Base.astro";
import Bilde from "../components/Bilde.astro";
import VerkKort from "../components/VerkKort.astro";
import Lyskasse from "../components/Lyskasse.astro";
import Tekst from "../components/Tekst.astro";
import Former from "../components/Former.astro";
import { sideMedNokkel, framhevedeVerk, alleKunstnere } from "../lib/sanity";

const side = await sideMedNokkel("forside");
const verk = await framhevedeVerk();
const kunstnere = await alleKunstnere();

// Hvert bein har sin egen form. Sirklene er kunsten som møter et publikum,
// de stablede rammene er passepartouten, strekene er trykkarket.
const bein = [
  {
    tittel: "Kunst",
    tekst:
      "Original grafikk, malerier og skulptur fra kunstnerne vi samarbeider med. Salgsutstillinger for bedrifter og kunstforeninger.",
    url: "/galleri",
    lenke: "Se verk",
    form: "sirkler" as const,
  },
  {
    tittel: "Utsmykking",
    tekst:
      "Vi setter sammen, rammer inn og henger opp kunst til kontorer, institusjoner og fellesarealer.",
    url: "/utsmykking",
    lenke: "Om utsmykking",
    form: "strek" as const,
  },
  {
    tittel: "Rammeverksted",
    tekst:
      "Komplett og moderne rammeverksted. Håndlagde rammer i høy kvalitet, tilpasset hvert verk.",
    url: "/rammeverkstedet",
    lenke: "Om rammeverkstedet",
    form: "ramme" as const,
  },
];
---

<Base tittel="Kunstformidling og rammeverksted">
  <section class="apning formlag formlag--klipp">
    <Former variant="bue" klasse="form--apning-bue" />

    <div class="innhold apning__rad overform">
      <div class="apning__tekst">
        <h1>{side?.tittel}</h1>
        <p class="ingress">{side?.ingress}</p>
        <p><a class="knapp" href="/galleri">Se verkene</a></p>
      </div>
      {side?.bilde && (
        <div class="apning__bilde">
          <Former variant="raster" klasse="form--bilde-raster" />
          <Bilde
            kilde={side.bilde}
            alt={side.bilde?.alt || ""}
            bredde={1100}
            variant="bred"
            loading="eager"
          />
        </div>
      )}
    </div>
  </section>

  <section class="seksjon innhold">
    <ul class="bein">
      {
        bein.map((b) => (
          <li>
            <Former variant={b.form} klasse="form--merke" />
            <h2>{b.tittel}</h2>
            <p>{b.tekst}</p>
            <p><a href={b.url}>{b.lenke}</a></p>
          </li>
        ))
      }
    </ul>
  </section>

  {
    verk.length > 0 && (
      <section class="seksjon seksjon--delt innhold formlag">
        <Former variant="passkors" klasse="form--seksjonsmerke" />
        <p class="stikkord">Utvalgte verk</p>
        <ul class="rutenett">
          {verk.map((v: any) => (
            <li><VerkKort verk={v} /></li>
          ))}
        </ul>
        <p class="mer"><a href="/galleri">Alle verk</a></p>
      </section>
    )
  }

  {
    side?.tekst && (
      <section class="seksjon seksjon--delt innhold">
        <Tekst verdi={side.tekst} />
      </section>
    )
  }

  {
    kunstnere.length > 0 && (
      <section class="seksjon seksjon--delt innhold formlag">
        <Former variant="passkors" klasse="form--seksjonsmerke" />
        <p class="stikkord">Kunstnere</p>
        <p class="navneliste">
          {kunstnere.map((k: any, i: number) => (
            <>
              {i > 0 && <span aria-hidden="true"> · </span>}
              <a href={`/kunstnere/${k.slug}`}>{k.navn}</a>
            </>
          ))}
        </p>
      </section>
    )
  }

  <Lyskasse />
</Base>

<style>
  .apning {
    padding-top: clamp(2rem, 6vw, 4.5rem);
  }

  /* Rasteret ligger absolutt inne i denne, og bak bildet. */
  .apning__bilde {
    position: relative;
  }

  .apning__rad {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  @media (min-width: 56rem) {
    .apning__rad {
      grid-template-columns: 1fr 1.15fr;
    }
  }

  .bein {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    border-top: 1px solid var(--strek);
    padding-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  @media (min-width: 48rem) {
    .bein {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .bein h2 {
    font-size: 1.375rem;
  }

  .mer {
    margin-top: 2.5rem;
    font-family: var(--sans);
    font-size: 0.9375rem;
  }

  .navneliste {
    max-width: 46em;
    font-size: 1.125rem;
    line-height: 2;
  }
</style>
